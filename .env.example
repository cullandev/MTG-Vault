# Copy to .env and fill in. See ARCHITECTURE.md section 7 for the full surface.

# --- required ---------------------------------------------------------------
# The machine name. Convenient from other desktops; phones usually cannot resolve a
# bare Windows/NetBIOS name, so set LAN_IP too. Not a .local name.
LAN_HOSTNAME=MY-DESKTOP
# The machine's LAN address. Needs no name resolution, which makes it the reliable
# way in from a phone. Give the machine a DHCP reservation so this does not move.
LAN_IP=192.168.1.50
# openssl rand -hex 32
SECRET_KEY=change-me-to-64-hex-characters
# Seeds the argon2id hash on first run, then ignored. Change it in the UI after.
APP_PASSWORD=change-me

# --- storage ----------------------------------------------------------------
DATA_DIR=/data
BACKUP_DIR=/data/backups
BACKUP_KEEP_DAYS=30
# Second copy of every verified backup, so backups do not live on the disk they
# protect. Point it at a mounted NAS or second drive (must be visible inside the
# app container -- add a volume for it in docker-compose.yml).
#BACKUP_MIRROR_DIR=/mnt/nas/mtgvault-backups
IMAGE_CACHE_MAX_MB=4096

# --- behaviour --------------------------------------------------------------
TZ=UTC
LOG_LEVEL=INFO
SESSION_TTL_DAYS=90
PRICE_MOVE_FLAG_PCT=15

# --- Scryfall ---------------------------------------------------------------
# Scryfall requires an identifying User-Agent and a 50-100ms gap between calls.
SCRYFALL_USER_AGENT=MTGVault/0.1 (self-hosted; +https://github.com/cullandev/MTG-public)
SCRYFALL_MIN_INTERVAL_MS=100
# default_cards = ~1 printing per card, effectively English (see OPEN-QUESTIONS B2).
# all_cards = every language, ~2GB, ~1.5M rows.
SCRYFALL_BULK_TYPE=default_cards

# --- scanning (Phase 2) -----------------------------------------------------
OCR_ENGINE=tesseract
SCAN_MAX_CONCURRENCY=2
# Fuzzy-match thresholds: at or above ACCEPT the name match locks in; between
# AMBIGUOUS and ACCEPT the phone shows a picker instead.
#SCAN_ACCEPT_SCORE=88
#SCAN_AMBIGUOUS_SCORE=82

# --- Forge battle sidecar (optional) ----------------------------------------
# Real AI-vs-AI games. Start the sidecar with:
#   docker compose --profile battles up -d
# and flip this on; leave it false to skip the ~4 GB Forge container entirely.
ENABLE_FORGE=false
#FORGE_URL=http://forge:8080
#FORGE_GAMES_DEFAULT=3

# --- AI (Phase 5, entirely optional) ----------------------------------------
# Unset => every AI feature reports itself disabled; nothing else changes.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
AI_MONTHLY_TOKEN_BUDGET=2000000

# --- external sources -------------------------------------------------------
ENABLE_EDHREC=true
ENABLE_SPELLBOOK=true
# Opt-in per source (ADR-016). edhtop16 is the one documented public API.
META_SOURCES_ENABLED=edhtop16
META_SNAPSHOT_INTERVAL_DAYS=7
META_STALE_AFTER_DAYS=14


# --- authentication ---------------------------------------------------------
# This build has NO login screen: it was deleted deliberately for a
# single-user LAN instance, so the app expects the backend to skip the
# session check. Leave this on unless you are re-introducing a login UI --
# with it off, every request 401s and there is no way in.
AUTH_DISABLED=true

# Keep the last N scanned frames and crops under data/scan-debug/ for
# diagnosing a scanner that will not lock on. 0 disables capture.
# SCAN_DEBUG_FRAMES=0
# Language the scanner assumes when the collector line does not say.
# SCAN_DEFAULT_LANG=en
# Set to false to run the app without the background scheduler (one-off maintenance).
# ENABLE_SCHEDULER=true
